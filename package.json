{
  "name": "lumen-atelier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lumen Atelier — a local-first photo editing studio with AI reference-to-preset generation.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts --api-only",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "setup:models": "node scripts/setup-models.mjs",
    "postinstall": "node scripts/copy-wasm-runtimes.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@gsap/react": "2.1.2",
    "@huggingface/transformers": "4.3.1",
    "@mediapipe/tasks-vision": "1.1.0",
    "@react-three/fiber": "9.8.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.1",
    "idb": "8.0.4",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-web": "1.30.0"
    }
  }
}
