# Server-side only. NEVER prefix these with VITE_ — they must not reach the browser bundle.

# Anthropic API key used by the local API server (server/) for reference-style interpretation.
# Without it the app still works: reference analysis falls back to measured statistics only,
# and the UI says so explicitly.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# API_PORT=8787
# Max requests per minute per client IP for the AI endpoint
# AI_RATE_LIMIT_PER_MINUTE=10
